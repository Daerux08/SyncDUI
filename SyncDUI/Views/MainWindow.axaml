<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SyncDUI.ViewModels"
        xmlns:views="using:SyncDUI.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="980" d:DesignHeight="720"
        x:Class="SyncDUI.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="SyncDUI"
        Width="1100" Height="760">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <TabControl Background="#F5F5F5">
        <TabItem Header="Overview">
            <views:OverviewTab DataContext="{Binding}" />
        </TabItem>

        <TabItem Header="Devices">
            <views:DevicesTab DataContext="{Binding}" />
        </TabItem>

        <TabItem Header="Folders">
            <views:FoldersTab DataContext="{Binding}" />
        </TabItem>

        <TabItem Header="Settings">
            <views:SettingsTab DataContext="{Binding}" />
        </TabItem>
    </TabControl>
</Window>
