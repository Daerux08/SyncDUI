<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SyncDUI.ViewModels"
             x:Class="SyncDUI.Views.OverviewTab"
             x:DataType="vm:MainViewModel">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="20" RowDefinitions="Auto,*" ColumnDefinitions="*" Background="#F5F5F5">
            <Border Padding="16" CornerRadius="10" Background="#FFFFFF" BorderBrush="#D9D9D9" BorderThickness="1">
                <StackPanel Spacing="12">
                    <TextBlock Text="SyncDUI" FontSize="24" FontWeight="SemiBold" Foreground="#111111" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Status:" FontWeight="SemiBold" Foreground="#111111" />
                        <TextBlock Text="{Binding ConnectionStatus}" Foreground="#0059B3" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Grid Grid.Row="1" Margin="0,20,0,0" ColumnDefinitions="1.2*,1.8*" ColumnSpacing="20">
                <StackPanel Spacing="16">
                    <Border Padding="16" CornerRadius="12" Background="#FFFFFF" BorderBrush="#D9D9D9" BorderThickness="1">
                        <StackPanel Spacing="8">
                            <TextBlock Text="System" FontSize="18" FontWeight="SemiBold" Foreground="#111111" />
                            <TextBlock Text="{Binding VersionSummary}" Foreground="#111111" />
                            <TextBlock Text="{Binding CurrentMachinePrettyName}" Foreground="#111111" />
                            <TextBlock Text="{Binding SystemSummary}" TextWrapping="Wrap" Foreground="#111111" />
                            <TextBlock Text="{Binding HealthSummary}" Foreground="#111111" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBlock Text="{Binding PathsSummary}" TextWrapping="Wrap" Foreground="#111111" />
                                <Button Content="📁" Width="32" Height="32" ToolTip.Tip="Open config folder" Click="OpenConfigFolder_Click" Grid.Column="1" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Padding="16" CornerRadius="12" Background="#FFFFFF" BorderBrush="#D9D9D9" BorderThickness="1">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Connected devices" FontSize="18" FontWeight="SemiBold" Foreground="#111111" />
                            <ListBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" Height="260" Background="#FFFFFF">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="8" CornerRadius="8" Background="#F7F7F7" BorderBrush="#E0E0E0" BorderThickness="1">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="{Binding PrettyName}" FontWeight="SemiBold" Foreground="#111111" />
                                                <TextBlock Text="{Binding StatusLabel}" Foreground="#1C7A35" />
                                                <TextBlock Text="{Binding Address}" TextTrimming="CharacterEllipsis" Foreground="#111111" />
                                                <TextBlock Text="{Binding Throughput}" Foreground="#111111" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <Border Padding="16" CornerRadius="12" Background="#FFFFFF" BorderBrush="#D9D9D9" BorderThickness="1">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Recent events" FontSize="18" FontWeight="SemiBold" Foreground="#111111" />
                            <ListBox ItemsSource="{Binding EventLog}" Height="180" Background="#FFFFFF">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="#111111" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="16">
                    <Border Padding="16" CornerRadius="12" Background="#FFFFFF" BorderBrush="#D9D9D9" BorderThickness="1">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Selected device" FontSize="18" FontWeight="SemiBold" Foreground="#111111" />
                            <TextBlock Text="{Binding SelectedDevice.PrettyName, FallbackValue='No device selected'}" FontSize="20" FontWeight="SemiBold" Foreground="#111111" />
                            <TextBlock Text="{Binding SelectedDevice.Address, FallbackValue=''}" Foreground="#111111" />
                            <TextBlock Text="{Binding SelectedDevice.ClientVersion, FallbackValue=''}" Foreground="#111111" />
                            <TextBlock Text="{Binding SelectedDevice.Type, FallbackValue=''}" Foreground="#111111" />
                            <TextBlock Text="{Binding SelectedDevice.Throughput, FallbackValue=''}" Foreground="#111111" />
                        </StackPanel>
                    </Border>

                    <Border Padding="16" CornerRadius="12" Background="#FFFFFF" BorderBrush="#D9D9D9" BorderThickness="1">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBlock Text="Folder stats" FontSize="18" FontWeight="SemiBold" Foreground="#111111" />
                                <Button Content="📁" Width="32" Height="32" ToolTip.Tip="Open selected folder" Click="OpenSelectedFolder_Click" Grid.Column="1" />
                            </Grid>
                            <TextBlock Text="{Binding FolderStatsSummary}" TextWrapping="Wrap" Foreground="#111111" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
